{
  "name": "wexample/symfony-trading-ds",
  "version": "2.0.1",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyTradingDs\\": "src/"
    }
  },
  "description": "Design-system side of symfony-trading: market charts drawn with Lightweight Charts",
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyTradingDs\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-trading": ">=3.0.0",
    "wexample/symfony-design-system": ">=50.0.0",
    "wexample/symfony-helpers": ">=19.3.0",
    "wexample/symfony-loader": ">=28.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}